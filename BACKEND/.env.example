# Cấu hình môi trường ứng dụng
APP_NAME="Ecommerce API - LTWEB NHOM 12"
APP_ENV=development
DEBUG=True
PORT=8000
HOST=0.0.0.0

# Cấu hình Database MySQL
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=ltweb_nhom12

# Database URL đầy đủ (Nếu để trống sẽ tự ghép từ DB_HOST, DB_USER, ...)
# MySQL: mysql+pymysql://root:@127.0.0.1:3306/ltweb_nhom12?charset=utf8mb4
# SQLite dự phòng: sqlite:///./ecommerce.db
DATABASE_URL=mysql+pymysql://root:@127.0.0.1:3306/ltweb_nhom12?charset=utf8mb4

# Cấu hình bảo mật JWT Authentication
# Khóa bí mật tối thiểu 32 ký tự
SECRET_KEY=nhom12_super_secret_jwt_key_ecommerce_2026_xyz
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Cấu hình CORS Frontend
CORS_ORIGINS=["http://localhost", "http://127.0.0.1", "http://localhost:5500", "http://127.0.0.1:5500", "http://localhost:3000", "*"]
