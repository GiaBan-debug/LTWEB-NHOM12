AddDefaultCharset UTF-8
AddCharset UTF-8 .html .js .css .json .php
Options -Indexes
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteRule (^|/)\. - [F,L]
  RewriteRule ^(database|scripts|tests|docs|var|vendor)(/|$) - [F,L]
</IfModule>
<FilesMatch "(^\.|^composer\.(json|lock)$|\.(sql|log|ini|md|ps1|mjs)$)">
  Require all denied
</FilesMatch>
